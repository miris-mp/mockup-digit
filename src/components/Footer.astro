---
import { site } from "../data/site";
import { Linkedin, Instagram, Facebook } from "lucide-astro";

const socials = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/digitsrl",
    icon: "linkedin",
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/digitsrl",
    icon: "instagram",
  },
  {
    label: "X",
    href: "https://x.com/digitsrl",
    icon: "x",
  },
  {
    label: "Facebook",
    href: "https://www.facebook.com/digit.srl.benefit",
    icon: "facebook",
  },
].filter((social) => social.href.trim() !== "");

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-line bg-ink text-on-ink">
  <div class="wrapper">
    <div
      class="grid gap-12 py-14 md:grid-cols-[1fr_auto] md:items-start md:gap-20 md:py-20"
    >
      <!-- Identità DIGIT -->
      <div class="space-y-5">
        <p class="max-w-md text-base leading-relaxed text-on-ink-muted">
          La tecnologia ha valore quando genera valore per le persone
        </p>
      </div>

      <!-- Social su una sola riga -->
      {
        socials.length > 0 && (
          <nav aria-label="Profili social" class="space-y-5">
            <p class="text-xs uppercase tracking-widest text-on-ink-muted">
              Follow us
            </p>

            <ul class="flex items-center gap-6">
              {socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`DIGIT su ${social.label}`}
                    class="inline-flex size-10 items-center justify-center border border-ink-line text-on-ink transition-colors hover:border-accent hover:text-accent focus-visible:border-accent focus-visible:text-accent"
                  >
                    {social.icon === "linkedin" && (
                      <Linkedin
                        size={19}
                        strokeWidth={1.8}
                        aria-hidden="true"
                      />
                    )}

                    {social.icon === "instagram" && (
                      <Instagram
                        size={19}
                        strokeWidth={1.8}
                        aria-hidden="true"
                      />
                    )}

                    {social.icon === "facebook" && (
                      <Facebook
                        size={19}
                        strokeWidth={1.8}
                        aria-hidden="true"
                      />
                    )}

                    {social.icon === "x" && (
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        width="19"
                        height="19"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 1.153h7.594l5.243 6.93 6.064-6.93Zm-1.29 19.49h2.039L6.482 3.24H4.294l13.317 17.403Z" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    <!-- Copyright e Privacy -->
    <div
      class="flex flex-col gap-4 border-t border-ink-line py-6 text-xs text-on-ink-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. Tutti i diritti riservati.</p>

      <a
        href="/privacy-policy"
        class="transition-colors hover:text-accent focus-visible:text-accent"
      >
        Privacy Policy
      </a>
    </div>
  </div>
</footer>
