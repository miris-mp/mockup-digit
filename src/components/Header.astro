---
import { site } from "../data/site";
---
<header class="border-b border-line bg-bg">
  <div class="wrapper flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-5">
    <a href="/" class="font-mono text-lg font-bold tracking-tight">{site.name}<span class="text-accent-ink">_</span></a>
    <nav aria-label="Principale">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {site.nav.map(({ label, href }) => (
          <li><a href={href} class="underline-offset-4 hover:underline focus-visible:underline">{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
