---
import { Image } from "astro:assets";
import { site } from "../data/site";
import logo from "../assets/logo.png";
---

<header class="border-b border-line bg-bg">
  <div
    class="wrapper flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-5"
  >
    <a
      href="/"
      aria-label={`${site.name} — Homepage`}
      class="inline-flex items-center"
    >
      <Image src={logo} alt={site.name} class="h-20 w-auto object-contain" />
    </a>

    <nav aria-label="Principale">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          site.nav.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="underline-offset-4 hover:underline focus-visible:underline"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
