---
import { Image } from "astro:assets";
import type { Person } from "../data/home";

interface Props {
  members: Person[];
}

const { members } = Astro.props;
---

<ul class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
  {
    members.map((person) => (
      <li class="group min-w-0">
        <div class="aspect-square overflow-hidden border border-line bg-surface">
          {person.image ? (
            <Image
              src={person.image}
              alt={`Ritratto di ${person.name}`}
              widths={[240, 360, 480, 640]}
              sizes="(min-width: 1024px) 240px, (min-width: 768px) 33vw, 50vw"
              class="h-full w-full object-cover transition-[filter] duration-300 "
              loading="lazy"
            />
          ) : (
            <div class="flex h-full items-center justify-center text-4xl font-medium text-muted">
              {person.name
                .split(" ")
                .map((word) => word[0])
                .slice(0, 2)
                .join("")}
            </div>
          )}
        </div>

        <div class="mt-3 space-y-1">
          <h3 class="text-sm font-medium leading-snug">{person.name}</h3>

          <p class="text-xs text-muted">{person.role}</p>
        </div>
      </li>
    ))
  }
</ul>
